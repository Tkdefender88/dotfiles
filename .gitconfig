[user]
	name = Justin Bak (╯°□°)╯︵ ┻━┻
	email = me@justinbak.com
	signingkey = /home/juicetin/.ssh/id_ed25519_sk_rk.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[pull]
	rebase = true
[init]
  defaultBranch = master
[alias]
  co = checkout
  st = status
  sup = status
  ci = commit
  br = branch
  yoink = pull
  yeet = push
  ls = ls-files
  unstage = reset HEAD
[core]
  pager = "hunk pager"
[diff]
  tool = hunk
[difftool "hunk"]
	cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[difftool]
	prompt = false

