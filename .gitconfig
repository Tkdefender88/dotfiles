[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[pull]
	rebase = true
[init]
	defaultBranch = master
[user]
	name = Justin Bak (╯°□°)╯︵ ┻━┻
	email = me@justinbak.com
	signingkey = /home/juicetin/.ssh/id_ed25519_sk_rk.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[difftool "hunk"]
	cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[difftool]
	prompt = false
